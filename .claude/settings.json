{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/harness/hook.py\" pre", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/harness/hook.py\" post", "timeout": 90 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/harness/hook.py\" stop", "timeout": 600 }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(make check)",
      "Bash(make check-fast)",
      "Bash(make check-all)",
      "Bash(make fmt-check)",
      "Bash(make vet)",
      "Bash(make lint)",
      "Bash(make test)",
      "Bash(make coverage)",
      "Bash(make arch-test)",
      "Bash(make bdd)",
      "Bash(make guide-lint)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go build:*)",
      "Bash(gofmt:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(python3 scripts/harness/guide_lint.py:*)"
    ]
  }
}
