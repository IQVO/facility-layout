{"title":"Body","body":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["siteCode","name"],"properties":{"siteCode":{"type":"string","pattern":"^[A-Z0-9]+$","description":"Uppercase alphanumeric code. Becomes the first LocationCode segment.","example":"WH1"},"name":{"type":"string","minLength":1,"description":"Human-readable facility name.","example":"Fulfilment Centre One"},"siteRole":{"type":"string","description":"The site's role in the fulfilment network (ADR-0037). `UNSPECIFIED` means nobody classified the site yet; it is the registration default and cannot be assigned by `PUT /sites/{siteCode}/role`.\n","enum":["UNSPECIFIED","ROBOTICS_SORTABLE_FC","NON_SORTABLE_FC","TRADITIONAL_SORTABLE_FC","SUB_SAME_DAY_FC","FRESH_GROCERY_FC","XL_FC","SOFT_LINES_SORTABLE_FC","MICRO_FC","SIMULATED_FC","INBOUND_CROSS_DOCK","NATIONAL_INBOUND_CROSS_DOCK","RETURNS_CENTER","SORTATION_CENTER","DELIVERY_STATION","AIR_HUB_GATEWAY"],"example":"NON_SORTABLE_FC","title":"SiteRole"}},"title":"RegisterSiteRequest"},"example":{"siteCode":"ABE8","name":"ABE8 - Non-Sortable Fulfillment Center (Breinigsville, PA)","siteRole":"NON_SORTABLE_FC"}}}}}